{
  "name": "@jerrysoer/mixtape",
  "version": "0.0.1",
  "description": "Clone a proven ad format into a new, original 9:16 ad. CLI + Claude Code skill.",
  "type": "module",
  "license": "MIT",
  "author": "Jerry Soer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jerrysoer/mixtape.git"
  },
  "bin": {
    "mixtape": "dist/bin.js",
    "mx": "dist/bin.js"
  },
  "files": [
    "dist",
    "templates",
    "python",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/bin.js",
    "dev": "tsx src/bin.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
